# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mariab_api
DB_PASSWORD=123456
DB_NAME=mariab
# Orígenes permitidos (CORS), separados por coma
ALLOWED_ORIGINS=https://jonathanstickgb.github.io,http://localhost:5500,http://127.0.0.1:5500
# Token para las rutas de administración (mínimo 20 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=3ece51647de79a4177e6f5d6d29ea56bea0b151ca645e886
# Pon true solo si la API está detrás de un proxy (Render, Nginx...) para leer la IP real
TRUST_PROXY=false
